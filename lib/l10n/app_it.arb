  "sonarpadCodeInvalidMessage": "Il codice Sonarpad inserito non è valido. Verifica di averlo copiato senza spazi aggiuntivi.",
  "@sonarpadCodeInvalidMessage": {
    "description": "Localized text for sonarpadCodeInvalidMessage."
